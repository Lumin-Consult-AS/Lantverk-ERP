{
  "realm": "erp-dev",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "erp-web",
      "name": "ERP Generisk Klient (Lokal Dev)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "erp-web-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "erp-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
