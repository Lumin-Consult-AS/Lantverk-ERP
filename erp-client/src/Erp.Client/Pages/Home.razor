@page "/"
@inject ErpApiClient Api
@inject I18nService I18n
@inject NavigationManager Nav
@implements IDisposable

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <MudText Typo="Typo.h5" Class="mb-3">@I18n.T("ui.nav.home")</MudText>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" data-error="true">@_error</MudAlert>
            }
            @if (_attention.Count(i => !i.Hidden) == 0)
            {
                <MudAlert Severity="Severity.Info">@I18n.T("ui.status.worklistEmpty")</MudAlert>
            }

            @foreach (var item in _attention.Where(i => _showHidden || !i.Hidden))
            {
                <MudAlert Severity="@SeverityOf(item)" Class="mb-2" Variant="@(item.Hidden ? Variant.Outlined : Variant.Filled)"
                          data-attention-id="@item.Id">
                    <div class="d-flex flex-wrap align-center gap-2">
                        <b>@item.Label</b>
                        <MudChip T="string" Size="Size.Small">@item.Count</MudChip>
                        <MudSpacer />
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" OnClick="@(() => OpenAttention(item))">
                            @I18n.T("ui.attention.open")
                        </MudButton>
                        @if (item.Hidden)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" OnClick="@(() => RestoreAttentionAsync(item))">
                                @I18n.T("ui.attention.showHidden")
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" OnClick="@(() => SnoozeAttentionAsync(item))">
                                @I18n.T("ui.attention.snooze")
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" OnClick="@(() => HideAttentionAsync(item))">
                                @I18n.T("ui.attention.hide")
                            </MudButton>
                        }
                    </div>
                </MudAlert>
            }

            @if (_attention.Any(i => i.Hidden))
            {
                <MudSwitch T="bool" @bind-Value="_showHidden" Label="@I18n.T("ui.attention.showHidden")" Color="Color.Primary" />
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Elevation="2" Class="pa-4 mb-4">
            <div class="d-flex flex-wrap align-center justify-space-between mb-3 gap-2">
                <MudText Typo="Typo.h6">@I18n.T("ui.nav.apps")</MudText>
                <div class="d-flex gap-1">
                    @if (!IsCorePartiesInstalled)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@InstallCorePartiesAsync"
                                   data-action="install-core-parties">
                            @I18n.T("ui.action.installCoreParties")
                        </MudButton>
                    }
                    else if (!IsDemoContactsInstalled)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="@InstallDemoContactsAsync"
                                   data-action="install-demo-contacts">
                            Installer Kontakter (demo.contacts)
                        </MudButton>
                    }
                </div>
            </div>

            @if (_installedApps.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Ingen apper er installert i denne tenanten ennå.
                </MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Bordered="true">
                    <thead>
                        <tr>
                            <th>App</th>
                            <th>Versjon</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in _installedApps)
                        {
                            <tr data-app-id="@app.AppId">
                                <td><b>@app.Name</b> (@app.AppId)</td>
                                <td>@app.Version</td>
                                <td class="d-flex justify-end gap-1">
                                    @if (string.Equals(app.AppId, "core.parties", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => Nav.NavigateTo("/page/core.party-list"))">
                                            Åpne
                                        </MudButton>
                                    }
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Outlined"
                                               Color="Color.Error"
                                               OnClick="@(() => UninstallAppAsync(app.AppId))">
                                        @I18n.T("ui.action.uninstall")
                                    </MudButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<ClientInstalledAppSummary> _installedApps =>
        Api.CurrentSession?.InstalledApps ?? [];

    private bool IsCorePartiesInstalled =>
        _installedApps.Any(a => string.Equals(a.AppId, "core.parties", StringComparison.OrdinalIgnoreCase));

    private bool IsDemoContactsInstalled =>
        _installedApps.Any(a => string.Equals(a.AppId, "demo.contacts", StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<ClientAttentionItem> _attention = [];
    private bool _showHidden;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Api.OnStateChanged += OnApiStateChanged;
        I18n.OnLocaleChanged += StateHasChanged;

        try
        {
            if (Api.CurrentAuth is null)
            {
                if (await Api.DevLoginAsync() is null)
                {
                    _error = string.Format(I18n.T("ui.error.login"), Api.ApiAddress);
                    return;
                }
            }
            else if (Api.CurrentSession is null)
            {
                await Api.RefreshSessionAndMetadataAsync();
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or NotSupportedException)
        {
            _error = string.Format(I18n.T("ui.error.login"), Api.ApiAddress);
            return;
        }

        await LoadAttentionAsync();
    }

    private async void OnApiStateChanged()
    {
        await LoadAttentionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAttentionAsync()
    {
        try
        {
            _attention = await Api.GetAttentionAsync();
        }
        catch (HttpRequestException)
        {
            _attention = [];
        }
    }

    private static Severity SeverityOf(ClientAttentionItem item) => item.Severity.ToLowerInvariant() switch
    {
        "action" => Severity.Error,
        "warning" => Severity.Warning,
        _ => Severity.Info
    };

    private void OpenAttention(ClientAttentionItem item)
    {
        if (item.Page is "core.tasks")
        {
            Nav.NavigateTo("/tasks");
        }
        else if (item.Page is "core.inbox")
        {
            Nav.NavigateTo("/inbox");
        }
        else if (!string.IsNullOrWhiteSpace(item.Page))
        {
            Nav.NavigateTo($"/page/{item.Page}");
        }
    }

    private async Task HideAttentionAsync(ClientAttentionItem item)
    {
        await Api.HideAttentionAsync(item.Id);
        await LoadAttentionAsync();
    }

    private async Task SnoozeAttentionAsync(ClientAttentionItem item)
    {
        await Api.SnoozeAttentionAsync(item.Id, 24);
        await LoadAttentionAsync();
    }

    private async Task RestoreAttentionAsync(ClientAttentionItem item)
    {
        await Api.RestoreAttentionAsync(item.Id);
        await LoadAttentionAsync();
    }

    private Task InstallCorePartiesAsync() => RunAppActionAsync(() => Api.InstallBuiltInAppAsync("core.parties"), "ui.error.install");

    private Task InstallDemoContactsAsync() => RunAppActionAsync(() => Api.InstallBuiltInAppAsync("demo.contacts"), "ui.error.install");

    private Task UninstallAppAsync(string appId) => RunAppActionAsync(() => Api.UninstallAppAsync(appId), "ui.error.uninstall");

    /// <summary>Runs an install/uninstall and tells the user when it did not work, instead of failing silently.</summary>
    private async Task RunAppActionAsync(Func<Task<bool>> action, string errorKey)
    {
        _error = null;
        try
        {
            if (!await action())
            {
                _error = string.Format(I18n.T(errorKey), Api.ApiAddress);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or NotSupportedException)
        {
            _error = $"{string.Format(I18n.T(errorKey), Api.ApiAddress)} ({ex.Message})";
        }
    }

    public void Dispose()
    {
        Api.OnStateChanged -= OnApiStateChanged;
        I18n.OnLocaleChanged -= StateHasChanged;
    }
}

