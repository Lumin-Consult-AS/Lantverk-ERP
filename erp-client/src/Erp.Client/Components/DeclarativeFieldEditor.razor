@using System.Globalization
@inject I18nService I18n
@inject ErpApiClient Api
@inject RegionService Region

@if (ClientFieldValidator.IsFieldVisible(Field, RecordFields))
{
    <div class="mb-3" data-field="@ExposedName">
        @if (Field.Type == ClientFieldType.Boolean)
        {
            <MudCheckBox T="bool"
                         Label="@DisplayLabel"
                         Value="@GetBoolValue()"
                         ValueChanged="@OnBoolChanged"
                         Disabled="@IsReadOnly"
                         Color="Color.Primary" />
        }
        else if (Field.Type == ClientFieldType.Enum && EnumValues.Count > 0)
        {
            <MudSelect T="string"
                       Label="@DisplayLabel"
                       Value="@GetStringValue()"
                       ValueChanged="@OnStringChanged"
                       Required="@IsRequired"
                       ReadOnly="@IsReadOnly"
                       Error="@(!string.IsNullOrEmpty(ValidationError))"
                       ErrorText="@ValidationError"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (var opt in EnumValues)
                {
                    <MudSelectItem T="string" Value="@opt">@opt</MudSelectItem>
                }
            </MudSelect>
        }
        else if (Field.Type == ClientFieldType.Reference && !string.IsNullOrWhiteSpace(Field.TargetObject))
        {
            <MudSelect T="string"
                       Label="@DisplayLabel"
                       Value="@GetStringValue()"
                       ValueChanged="@OnStringChanged"
                       Required="@IsRequired"
                       ReadOnly="@IsReadOnly"
                       Clearable="@(!IsRequired && !IsReadOnly)"
                       Error="@(!string.IsNullOrEmpty(ValidationError))"
                       ErrorText="@ValidationError"
                       HelperText="@(_options.Count == 0 && _optionsLoaded ? NoOptionsText : null)"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (var opt in _options)
                {
                    <MudSelectItem T="string" Value="@opt.Value">@opt.Label</MudSelectItem>
                }
            </MudSelect>
        }
        else if (Field.Type == ClientFieldType.Date)
        {
            <MudTextField T="string"
                          Label="@DisplayLabel"
                          Value="@GetStringValue()"
                          ValueChanged="@OnStringChanged"
                          Required="@IsRequired"
                          ReadOnly="@IsReadOnly"
                          Placeholder="@Region.Current.DateFormat"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                          OnAdornmentClick="@OpenPickerAsync"
                          Error="@(!string.IsNullOrEmpty(ValidationError))"
                          ErrorText="@ValidationError"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <MudDatePicker @ref="_picker"
                           PickerVariant="PickerVariant.Dialog"
                           Date="@PickerDate"
                           DateChanged="@OnPickerChanged"
                           FirstDayOfWeek="@Region.Current.FirstDayOfWeek"
                           Class="d-none" />
        }
        else if (Field.Type == ClientFieldType.Decimal || Field.Type == ClientFieldType.Integer)
        {
            <MudTextField T="string"
                          Label="@DisplayLabel"
                          Value="@GetStringValue()"
                          ValueChanged="@OnStringChanged"
                          Required="@IsRequired"
                          ReadOnly="@IsReadOnly"
                          Error="@(!string.IsNullOrEmpty(ValidationError))"
                          ErrorText="@ValidationError"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Style="text-align:right" />
        }
        else if (Field.Type == ClientFieldType.Text)
        {
            <MudTextField T="string"
                          Label="@DisplayLabel"
                          Value="@GetStringValue()"
                          ValueChanged="@OnStringChanged"
                          Lines="3"
                          Required="@IsRequired"
                          ReadOnly="@IsReadOnly"
                          MaxLength="@(Field.MaxLength ?? 4000)"
                          Error="@(!string.IsNullOrEmpty(ValidationError))"
                          ErrorText="@ValidationError"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        }
        else
        {
            <MudTextField T="string"
                          Label="@DisplayLabel"
                          Value="@GetStringValue()"
                          ValueChanged="@OnStringChanged"
                          Required="@IsRequired"
                          ReadOnly="@IsReadOnly"
                          MaxLength="@(Field.MaxLength ?? 255)"
                          Error="@(!string.IsNullOrEmpty(ValidationError))"
                          ErrorText="@ValidationError"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ClientFieldDefinition Field { get; set; } = default!;
    [Parameter, EditorRequired] public string ObjectOwnerApp { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Dictionary<string, object?> RecordFields { get; set; } = default!;
    [Parameter] public IReadOnlyList<string> EnumValues { get; set; } = [];
    [Parameter] public string? ValidationError { get; set; }
    [Parameter] public EventCallback OnValueChanged { get; set; }

    private sealed record RefOption(string Value, string Label);

    private List<RefOption> _options = [];
    private bool _optionsLoaded;
    private string? _loadedTarget;

    private string NoOptionsText => $"Ingen poster finnes i {Field.TargetObject} ennå. Opprett en først.";

    protected override async Task OnParametersSetAsync()
    {
        if (Field.Type != ClientFieldType.Reference
            || string.IsNullOrWhiteSpace(Field.TargetObject)
            || string.Equals(_loadedTarget, Field.TargetObject, StringComparison.Ordinal))
        {
            return;
        }

        _loadedTarget = Field.TargetObject;
        try
        {
            var rows = await Api.QueryRecordsAsync(Field.TargetObject, top: 200);
            _options = rows.Select(r => new RefOption(r.Id.ToString("D"), RecordLabel(r))).OrderBy(o => o.Label).ToList();
        }
        catch (Exception)
        {
            _options = [];
        }

        _optionsLoaded = true;
    }

    // Shows the business key and name when the target has them (code/name, itemNumber/name ...); falls back to the id.
    private static string RecordLabel(ClientRecordData r)
    {
        string Get(string key) => r.Fields.TryGetValue(key, out var v) ? I18nService.UnwrapDisplayString(v) : string.Empty;

        var key = new[] { "code", "itemNumber", "partyNumber", "number" }.Select(Get).FirstOrDefault(s => s.Length > 0) ?? string.Empty;
        var name = Get("name");
        var label = key.Length > 0 && name.Length > 0 ? $"{key} – {name}" : key.Length > 0 ? key : name;
        return label.Length > 0 ? label : r.Id.ToString("D")[..8];
    }

    private string ExposedName => Field.GetExposedName(ObjectOwnerApp);
    private bool IsRequired => ClientFieldValidator.IsFieldRequired(Field, RecordFields);
    private bool IsReadOnly => ClientFieldValidator.IsFieldReadOnly(Field, RecordFields);

    private string DisplayLabel
    {
        get
        {
            var baseLabel = I18n.T($"parties.fields.{Field.Name}", I18n.T(Field.Label, Field.Label ?? Field.Name));
            return IsRequired ? $"{baseLabel} *" : baseLabel;
        }
    }

    private MudDatePicker? _picker;

    // The value as the region writes it. Text that could not be read stays as the user typed it (and is refused on save).
    private string GetStringValue()
    {
        if (RecordFields.TryGetValue(ExposedName, out var val) && val is not null)
        {
            return Region.Display(Field, val);
        }

        if (Field.DefaultValue is not null)
        {
            return Region.Display(Field, Field.DefaultValue);
        }

        return string.Empty;
    }

    private DateTime? PickerDate =>
        RecordFields.TryGetValue(ExposedName, out var val) && val is not null
        && DateOnly.TryParseExact(I18nService.UnwrapDisplayString(val), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date.ToDateTime(TimeOnly.MinValue)
            : null;

    private async Task OpenPickerAsync()
    {
        if (!IsReadOnly && _picker is not null)
        {
            await _picker.OpenAsync();
        }
    }

    private async Task OnPickerChanged(DateTime? picked)
    {
        RecordFields[ExposedName] = picked is { } d ? RegionService.ToIso(DateOnly.FromDateTime(d)) : null;
        await OnValueChanged.InvokeAsync();
    }

    private bool GetBoolValue()
    {
        if (RecordFields.TryGetValue(ExposedName, out var val) && val is not null)
        {
            if (val is bool b) return b;
            if (bool.TryParse(I18nService.UnwrapDisplayString(val), out var parsed)) return parsed;
        }

        if (Field.DefaultValue is bool defBool) return defBool;
        return false;
    }

    private async Task OnStringChanged(string? newValue)
    {
        if (string.IsNullOrWhiteSpace(newValue))
        {
            RecordFields[ExposedName] = null;
        }
        else if (Field.Type == ClientFieldType.Date && Region.TryParseDate(newValue, out var date))
        {
            // Whatever the region writes, the API gets ISO 8601
            RecordFields[ExposedName] = RegionService.ToIso(date);
        }
        else if (Field.Type == ClientFieldType.Integer && Region.TryParseNumber(newValue, out var whole) && whole == decimal.Truncate(whole))
        {
            RecordFields[ExposedName] = (long)whole;
        }
        else if (Field.Type == ClientFieldType.Decimal && Region.TryParseNumber(newValue, out var d))
        {
            RecordFields[ExposedName] = d;
        }
        else
        {
            RecordFields[ExposedName] = newValue;
        }

        await OnValueChanged.InvokeAsync();
    }

    private async Task OnBoolChanged(bool newValue)
    {
        RecordFields[ExposedName] = newValue;
        await OnValueChanged.InvokeAsync();
    }
}

