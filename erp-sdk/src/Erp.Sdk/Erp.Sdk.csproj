<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Erp.Sdk</RootNamespace>
    <PackageId>Erp.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>Jens Nymoen</Authors>
    <License>Apache-2.0</License>
    <Description>Public SDK and gRPC contracts for building ERP apps on the Laftverk ERP platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\protos\erp_contracts.proto" GrpcServices="Both" Link="Protos\erp_contracts.proto" />
  </ItemGroup>
</Project>

